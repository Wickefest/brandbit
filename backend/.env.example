# Kimi API key (fragrance / music / refinement text)
KIMI_API_KEY=

# Replicate token (vision, judge, MusicGen, CLIP)
REPLICATE_API_TOKEN=

# MusicGen backend: auto | replicate | remote | local | off
MUSICGEN_BACKEND=replicate

# Optional alias for REPLICATE_API_TOKEN when using MusicGen
MUSICGEN_API_KEY=

# CLIP proxies: auto | off | local | replicate
CLIP_BACKEND=auto
